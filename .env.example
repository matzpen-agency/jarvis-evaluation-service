# ============================================================
# Langfuse
# ============================================================
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# On a private network, point this at your self-hosted Langfuse
LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================================
# Trino
# ============================================================
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=trino
TRINO_PASSWORD=
TRINO_CATALOG=minio
TRINO_SCHEMA=simple_retail
TRINO_HTTP_SCHEME=http
TRINO_REQUEST_TIMEOUT=30.0
TRINO_ENABLED=true
TRINO_VERIFY=false
# Optional mTLS:
# TRINO_CERT_PATH=/path/to/client.crt
# TRINO_KEY_PATH=/path/to/client.key

# ============================================================
# Text-to-SQL Agent
# ============================================================
AGENT_URL=http://host.docker.internal:8000
AGENT_ENDPOINT=/api/agent/chat
AGENT_TIMEOUT=120.0
MCP_AGENT_URL=http://host.docker.internal:8001
# SQL dialect the agent writes; on connections with another dialect, generated
# SQL that fails is retried transpiled to the connection's dialect
# AGENT_SQL_DIALECT=trino

# ============================================================
# Jeen metadata — runs expected/generated SQL on the question's connection
# (run_query) and provides its schema/dialect. Without a key, SQL runs on
# Trino directly, which only works for Trino-backed connections.
# ============================================================
JEEN_METADATA_MCP_URL=http://schema-modeler.dev161.internal/api/mcp
JEEN_METADATA_MCP_KEY=mcp_...
# JEEN_METADATA_TIMEOUT=120.0
# JEEN_MAX_CONCURRENT_QUERIES=4

# ============================================================
# Evaluation
# ============================================================
MAX_CONCURRENT_EVALUATIONS=10
EVALUATION_HITL_ENABLED=false

# Per-question budget for running both SQLs + all evaluators (agent call excluded)
# EVALUATION_ITEM_TIMEOUT=600.0

# Time shift offsets in days (comma-separated negatives for past)
# TIME_SHIFT_OFFSETS_DAYS=[-1,-7,-14,-30,-60]
# TIME_SHIFT_TIMEOUT=180.0

# BIRD benchmark (dataset "bird"): runs the BIRD-Verified questions of the
# BIRD database the selected connection holds — name the Jeen connection after
# the BIRD db_id (e.g. "movie_platform" or "bird_movie_platform").
# The questions are bundled (src/config/bird/), so no internet access is needed.
# BIRD_DATASET_PATH=src/config/bird/bird_verified_cot_2462.jsonl
# BIRD_INCLUDE_EVIDENCE=true

# Composite score weights (must sum to 1.0)
# COMPOSITE_WEIGHT_CONTAINS_ACCURACY=0.40
# COMPOSITE_WEIGHT_TIME_SHIFT=0.25
# COMPOSITE_WEIGHT_EXECUTION_ACCURACY=0.15
# COMPOSITE_WEIGHT_COMPONENT_MATCH=0.10
# COMPOSITE_WEIGHT_SCHEMA_VALIDITY=0.05
# COMPOSITE_WEIGHT_DIALECT_VALIDITY=0.05
# COMPOSITE_WEIGHT_SQL_EXACT_MATCH=0.0

# ============================================================
# Service
# ============================================================
PORT=8002
APP_ENV=development
LOG_LEVEL=INFO

# ============================================================
# Backend API (for resolving production tables)
# ============================================================
BACKEND_URL=http://host.docker.internal:8000
