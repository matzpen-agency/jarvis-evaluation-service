# ============================================================
# Langfuse
# ============================================================
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================================
# Trino
# ============================================================
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=trino
TRINO_PASSWORD=
TRINO_CATALOG=minio
TRINO_SCHEMA=simple_retail
TRINO_HTTP_SCHEME=http
TRINO_REQUEST_TIMEOUT=30.0
TRINO_ENABLED=true
TRINO_VERIFY=false
# Optional mTLS:
# TRINO_CERT_PATH=/path/to/client.crt
# TRINO_KEY_PATH=/path/to/client.key

# ============================================================
# Text-to-SQL Agent
# ============================================================
AGENT_URL=http://localhost:8000
AGENT_ENDPOINT=/api/agent/chat
AGENT_TIMEOUT=120.0

# ============================================================
# Evaluation
# ============================================================
MAX_CONCURRENT_EVALUATIONS=10
EVALUATION_HITL_ENABLED=false

# Time shift offsets in days (comma-separated negatives for past)
# TIME_SHIFT_OFFSETS_DAYS=[-1,-7,-14,-30,-60]

# Composite score weights (must sum to 1.0)
# COMPOSITE_WEIGHT_EXECUTION_ACCURACY=0.60
# COMPOSITE_WEIGHT_CONTAINS_ACCURACY=0.15
# COMPOSITE_WEIGHT_SQL_EXACT_MATCH=0.15
# COMPOSITE_WEIGHT_TIME_SHIFT=0.10

# ============================================================
# Service
# ============================================================
PORT=8002
APP_ENV=development
LOG_LEVEL=INFO

# ============================================================
# Backend API (for resolving production tables)
# ============================================================
BACKEND_URL=http://localhost:8000
